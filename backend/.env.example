# Exemplo para execucao fora do Coolify.
# No Coolify, o docker-compose.yml gera os segredos SERVICE_* automaticamente.
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://hezzuz_logs:CHANGE_ME@postgres:5432/hezzuz_logs
DATABASE_SSL=false
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=10000
DB_STARTUP_RETRIES=30
DB_STARTUP_RETRY_MS=2000
TRUST_PROXY=1
REQUEST_BODY_LIMIT=4mb

ADMIN_USERNAME=admin
ADMIN_PASSWORD=MUDE_ESTA_SENHA
AUTH_SECRET=GERE_UMA_CHAVE_DE_64_CARACTERES
AUTH_TOKEN_HOURS=12
AUTH_COOKIE_NAME=hezzuz_logs_session
AUTH_COOKIE_SECURE=true
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_SECONDS=300

HEZZUZ_INGEST_KEYS={"survival":"SECRET_SURVIVAL","lobby":"SECRET_LOBBY","skyblock":"SECRET_SKYBLOCK"}
INGEST_MAX_BATCH=100
INGEST_CLOCK_SKEW_SECONDS=300
INGEST_RATE_PER_SECOND=500
SERVER_OFFLINE_AFTER_SECONDS=90
EVENT_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=50000

DISCORD_FORWARD_MODE=critical
DISCORD_WEBHOOK_DEFAULT=
DISCORD_WEBHOOK_MODERATION=
DISCORD_WEBHOOK_ERRORS=
DISCORD_WEBHOOK_SERVER=
DISCORD_THROTTLE_MS=450
